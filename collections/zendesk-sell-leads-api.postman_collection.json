    "_postman_id": "be64853d-7029-4b35-a6da-b2d5e6573d5b",
    "name": "Zendesk Sell (Sales CRM) Contacts Leads API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Zendesk Sell Sales CRM API (formerly Base CRM) is a RESTful API hosted\nat api.getbase.com that provides programmatic CRUD access to Sell records\nincluding leads, contacts, deals, and other sales-pipeline resources. The\nSell platform also offers Sync, Firehose, and Search APIs alongside the\nCore API documented here. Authentication uses OAuth 2.0.\n\nContact Support:\n Name: Zendesk Developer Portal",
      "type": "text/plain"
    }
  }
